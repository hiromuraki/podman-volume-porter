[Unit]
Description=Backup Podman Volume to S3
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=oneshot

EnvironmentFile=%h/.env.podman-volume-porter

WorkingDirectory=%h/
ExecStart=/usr/local/bin/podman-volume-porter backup '*'

Restart=on-failure
RestartSec=30s
